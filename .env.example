# GRACE Environment Configuration Template
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth Session Secret (HMAC-SHA256 for jose JWT)
SESSION_SECRET=replace-with-long-random-secret-at-least-32-chars

# Firebase / Firestore
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# Resend Transactional Email
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Google Gemini / GCP API
GEMINI_API_KEY=your_gemini_api_key
GCP_API_KEY=your_gcp_api_key
GEMINI_MODEL=gemini-1.5-flash

# Cron & Automation
CRON_SHARED_SECRET=your_cron_shared_secret
DEMO_MODE=true
